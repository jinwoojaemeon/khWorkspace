<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kh.spring.model.mapper.BoardMapper">
    <resultMap id="boardResultMap" type="Board">
        <result column="BOARD_NO" property="boardNo"/>
        <result column="BOARD_TYPE" property="boardType"/>
        <result column="CATEGORY_NO" property="categoryNo"/>
        <result column="BOARD_TITLE" property="boardTitle"/>
        <result column="BOARD_CONTENT" property="boardContent"/>
        <result column="BOARD_WRITER" property="boardWriter"/>
        <result column="COUNT" property="count"/>
        <result column="STATUS" property="status"/>
        <result column="CREATE_DATE" property="createDate"/>
        <result column="CATEGORY_NAME" property="categoryName"/>
        <result column="MEMBER_ID" property="memberId"/>
        <result column="THUMBNAIL_IMG" property="thumbnailImg"/>
    </resultMap>

    <resultMap id="attachmentResultMap" type="Attachment">
        <result column="FILE_NO" property="fileNo"/>
        <result column="REF_BNO" property="refBoardNo"/>
        <result column="ORIGIN_NAME" property="originName"/>
        <result column="CHANGE_NAME" property="changeName"/>
        <result column="FILE_PATH" property="filePath"/>
        <result column="FILE_LEVEL" property="fileLevel"/>
    </resultMap>

    <resultMap id="categoryResultMap" type="Category">
        <result column="CATEGORY_NO" property="categoryNo"/>
        <result column="CATEGORY_NAME" property="categoryName"/>
    </resultMap>

    <resultMap id="replyResultMap" type="Reply">
        <result column="REPLY_NO" property="replyNo"/>
        <result column="REPLY_CONTENT" property="replyContent"/>
        <result column="REF_BNO" property="refBoardNo"/>
        <result column="REPLY_WRITER" property="replyWriter"/>
        <result column="MEMBER_ID" property="memberId"/>
        <result column="CREATE_DATE" property="createDate"/>
    </resultMap>

    <select id="selectAllBoardCount" resultType="_int">
        SELECT COUNT(*)
        FROM BOARD
        WHERE STATUS = 'Y'
        AND BOARD_TYPE = 1
    </select>

    <select id="selectAllBoard" resultMap="boardResultMap">
        SELECT  BOARD_NO, 
				CATEGORY_NAME,
				BOARD_TITLE,
				MEMBER_ID,
				COUNT,
				TO_CHAR(CREATE_DATE, 'YYYY-MM-DD') AS "CREATE_DATE"
		FROM BOARD B
		JOIN CATEGORY USING(CATEGORY_NO)
		JOIN MEMBER M ON(BOARD_WRITER = MEMBER_NO)
		WHERE B.STATUS = 'Y'
		AND BOARD_TYPE = 1
		ORDER BY BOARD_NO DESC
    </select>

    <select id="selectSearchBoardCount" resultType="_int">
		SELECT COUNT(*)
		FROM BOARD B
		JOIN MEMBER M ON(B.BOARD_WRITER = M.MEMBER_NO)
		WHERE B.STATUS = 'Y'
		AND B.BOARD_TYPE = 1
		<choose>
			<when test="condition eq 'writer'">
				AND M.MEMBER_ID 
			</when>
			<when test="condition eq 'content'">
				AND B.BOARD_CONTENT
			</when>
			<when test="condition eq 'title'">
				AND B.BOARD_TITLE
			</when>
		</choose>
		   LIKE '%${keyword}%'
	</select>

    <select id="selectSearchBoard" resultMap="boardResultMap">
		SELECT B.BOARD_NO,
				C.CATEGORY_NAME,
				B.BOARD_TITLE,
				M.MEMBER_ID,
				B.COUNT,
				TO_CHAR(B.CREATE_DATE, 'YYYY-MM-DD') AS "CREATE_DATE"
		FROM BOARD B
		JOIN CATEGORY C ON(B.CATEGORY_NO = C.CATEGORY_NO)
		JOIN MEMBER M ON(B.BOARD_WRITER = M.MEMBER_NO)
		WHERE B.STATUS = 'Y'
		AND B.BOARD_TYPE = 1
		<choose>
			<when test="condition eq 'writer'">
				AND M.MEMBER_ID 
			</when>
			<when test="condition eq 'content'">
				AND B.BOARD_CONTENT
			</when>
			<when test="condition eq 'title'">
				AND B.BOARD_TITLE
			</when>
		</choose>
		LIKE '%${keyword}%'
		ORDER BY B.BOARD_NO DESC
	</select>

</mapper>